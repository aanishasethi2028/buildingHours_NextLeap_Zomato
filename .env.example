# LLM (Phase 3+)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_SECONDS=30

# Recommendation limits (Phase 2+)
MAX_CANDIDATES=30
TOP_K_RESULTS=5

# Data layer (Phase 1)
DATA_CACHE_PATH=data/restaurants.json
HF_DATASET_ID=ManikaSaini/zomato-restaurant-recommendation
HF_DATASET_SPLIT=train
# Optional: limit rows during dev (unset = full dataset)
# MAX_INGEST_ROWS=1000
FORCE_REFRESH_CACHE=false
